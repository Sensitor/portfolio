{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Strict throughout, and `strictNullChecks` in particular is the point.
    // The API returns null for every figure the engine leaves undefined — a
    // profit factor with no losses, an R multiple with no stop — and without
    // this a screen would compile while rendering those as numbers.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx"
  },
  // `app/` is in here deliberately. It was not, once, and `npm run typecheck`
  // passed while every screen went unchecked — the screens are where the null
  // handling above actually has to hold.
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
